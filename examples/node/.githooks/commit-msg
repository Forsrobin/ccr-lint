#!/bin/sh
# Lint each commit message. `npm install` enables this hook through the "prepare" script.
if ! command -v ccr-lint >/dev/null 2>&1; then
  echo "commit-msg: ccr-lint is not installed, skipping (https://github.com/Forsrobin/ccr-lint/releases)" >&2
  exit 0
fi
exec ccr-lint lint --edit "$1"
