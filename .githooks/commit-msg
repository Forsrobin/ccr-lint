#!/bin/sh
# Lint the commit message with ccr-lint (Conventional Commits).
# Enable once per clone:  git config core.hooksPath .githooks
#
# Uses an installed `ccr-lint` if there is one, otherwise this repository's own build.
if command -v ccr-lint >/dev/null 2>&1; then
  exec ccr-lint lint --edit "$1"
fi
exec cargo run --quiet --release --locked -- lint --edit "$1"
